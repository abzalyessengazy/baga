# Postgres (Supabase: Project settings -> Database -> Connection string, "Transaction pooler")
DATABASE_URL=
# Public site URL, used in emails, sitemap and canonical links
SITE_URL=http://localhost:3000
# Resend (alerts). Leave empty to skip sending.
RESEND_API_KEY=
EMAIL_FROM="BAGA <alerts@your-domain>"
# Healthchecks.io ping URL for the worker (optional)
HEALTHCHECK_URL=
# Worker tuning. Request spacing (10 s) and the 04:00-08:45 UTC window come from kaspi.kz/robots.txt and are fixed in code.
COLLECT_CHUNK=10
COLLECT_WINDOW_WAIT_MIN=20
COLLECT_RUNNER=local
# Dev only: serve captured Kaspi fixtures instead of live data
BAGA_FIXTURES=
