# Copy to .env (worker, migrations) and the web variables to apps/web/.env.local. Both are gitignored.
# Postgres (Supabase: Connect -> "Transaction pooler", port 6543). TLS is verified against the embedded Supabase CA.
# backup.yml derives the session pooler (port 5432) from it for pg_dump.
DATABASE_URL=
# Public site URL, used in emails, sitemap and canonical links
SITE_URL=http://localhost:3000
# Resend (alerts). Leave empty to skip sending.
RESEND_API_KEY=
EMAIL_FROM="BAGA <alerts@your-domain>"
# Healthchecks.io ping URL for the worker (optional)
HEALTHCHECK_URL=
# Worker tuning. Request spacing (10 s) and the 04:00-08:45 UTC window come from kaspi.kz/robots.txt and are fixed in code.
COLLECT_CHUNK=10
COLLECT_WINDOW_WAIT_MIN=20
# Seconds between polls for new visitor requests while the window is open
COLLECT_IDLE_POLL_S=60
COLLECT_RUNNER=local
# Dev only: serve captured Kaspi fixtures instead of live data
BAGA_FIXTURES=
# Dev only: build into another folder so a running `pnpm dev` is not disturbed (e.g. .next-check)
BAGA_DIST_DIR=
# Cloudflare Turnstile (bot check before queuing an unknown product or resolving a short link). Dashboard -> Turnstile -> your widget;
# its hostname list must include the site's domain.
# Leave empty in development to use Cloudflare's always-pass test keys. Production refuses lookups without them.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
