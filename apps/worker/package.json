{
  "name": "@baga/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "collect": "node --env-file-if-exists=../../.env --import tsx src/collect.ts",
    "discover": "node --import tsx src/discover.ts",
    "seed": "node --env-file-if-exists=../../.env --import tsx src/seed.ts",
    "telegram:webhook": "node --env-file-if-exists=../../.env --env-file-if-exists=../web/.env.local --import tsx src/telegram-webhook.ts",
    "typecheck": "tsc --noEmit",
    "probe": "node --env-file-if-exists=../../.env --import tsx src/probe.ts",
    "probe:scale": "node --env-file-if-exists=../../.env --env-file-if-exists=../web/.env.local --import tsx src/probe-scale.ts",
    "probe:pairs": "node --env-file-if-exists=../../.env --env-file-if-exists=../web/.env.local --import tsx src/probe-pairs.ts",
    "stores": "node --env-file-if-exists=../../.env --import tsx src/stores.ts",
    "report": "node --env-file-if-exists=../../.env --env-file-if-exists=../web/.env.local --import tsx src/report.ts",
    "nudge": "node --env-file-if-exists=../../.env --env-file-if-exists=../web/.env.local --import tsx src/nudge.ts",
    "content": "node --env-file-if-exists=../../.env --env-file-if-exists=../web/.env.local --import tsx src/content.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@baga/core": "workspace:^",
    "@baga/db": "workspace:^",
    "@baga/kaspi": "workspace:^",
    "@baga/stores": "workspace:^",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
